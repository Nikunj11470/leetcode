","runtime":"128 ms","url":"/submissions/detail/2068510874/","is_pending":"Not Pending","title":"Delete Nodes From Linked List Present in Array","memory":"293.2 MB","code":"class Solution {\\npublic:\\n    ListNode* modifiedList(vector<int>& nums, ListNode* head) {\\n\\n        vector<int> arr;\\n\\n        ListNode* temp = head;\\n\\n        // Store linked list values in a vector\\n        while(temp){\\n            arr.push_back(temp->val);\\n            temp = temp->next;\\n        }\\n\\n        // Store nums in a hash set\\n        unordered_set<int> st(nums.begin(), nums.end());\\n\\n        // Keep only values not present in nums\\n        vector<int> ans;\\n\\n        for(int x : arr){\\n            if(!st.count(x)){\\n                ans.push_back(x);\\n            }\\n        }\\n\\n        // If no nodes remain\\n        if(ans.empty()){\\n            return NULL;\\n        }\\n\\n        // Build the new linked list\\n        ListNode* newHead = new ListNode(ans[0]);\\n        temp = newHead;\\n\\n        for(int i = 1; i < ans.size(); i++){\\n            temp->next = new ListNode(ans[i]);\\n            temp = temp->next;\\n        }\\n\\n        return newHead;\\n    }\\n};","compare_result":"","title_slug":"delete-nodes-from-linked-list-present-in-array","has_notes":false,"flag_type":1,"frontend_id":413},{"id":2068501799,"question_id":3501,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1784112669,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2068501799/","is_pending":"Not Pending","title":"Delete Nodes From Linked List Present in Array","memory":"N/A","code":"class Solution {\\npublic:\\n    ListNode* modifiedList(vector<int>& nums, ListNode* head) {\\n\\n        vector<int> arr;\\n\\n        ListNode* temp = head;\\n\\n        while(temp){\\n            arr.push_back(temp->val);\\n            temp = temp->next;\\n        }\\n\\n        for(int i = 0; i < arr.size(); i++){\\n\\n            for(int j = 0; j < nums.size(); j++){\\n\\n                if(arr[i] == nums[j]){\\n\\n                    arr.erase(arr.begin() + i);\\n                    i--;\\n                    break;\\n                }\\n            }\\n        }\\n\\n        if(arr.empty())\\n            return NULL;\\n\\n        ListNode* newHead = new ListNode(arr[0]);\\n\\n        temp = newHead;\\n\\n        for(int i = 1; i < arr.size(); i++){\\n\\n            temp->next = new ListNode(arr[i]);\\n\\n            temp = temp->next;\\n        }\\n\\n        return newHead;\\n    }\\n};","compare_result":"","title_slug":"delete-nodes-from-linked-list-present-in-array","has_notes":false,"flag_type":1,"frontend_id":412},{"id":2068481484,"question_id":2902,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1784111461,"status":10,"status_display":"Accepted","runtime":"12 ms","url":"/submissions/detail/2068481484/","is_pending":"Not Pending","title":"Max Pair Sum in an Array","memory":"74.3 MB","code":"class Solution {\\npublic:\\n    int maxSum(vector<int>& nums) {\\n        vector<int>ans;\\n        for(int i=0;i<nums.size();i++){\\n\\n            string s=to_string(nums[i]);\\n            int maxi=0;\\n            for(int j=0;j<s.size();j++){\\n                maxi=max(maxi,s[j]-\'0\');\\n            }\\n\\n            ans.push_back(maxi);\\n        }\\n       \\n\\n        int maxsum=-1;\\n\\n        for(int i=0;i<ans.size()-1;i++){\\n            for(int j=i+1;j<ans.size();j++){\\n            if(ans[i]==ans[j]){\\n                maxsum=max(maxsum,nums[i]+nums[j]);\\n            }\\n        }\\n        }\\n\\n        return maxsum;\\n    }\\n};\\n\\n","compare_result":"","title_slug":"max-pair-sum-in-an-array","has_notes":false,"flag_type":1,"frontend_id":411},{"id":2068460956,"question_id":3915,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1784110313,"status":14,"status_display":"Time Limit Excee