st2) {\\n        vector<string>ans;\\n\\n        int sum=INT_MAX;\\n\\n        for(int i=0;i<list1.size();i++){\\n            for(int j=0;j<list2.size();j++){\\n                if(list1[i]==list2[j]){\\n                    int p=i+j;\\n\\n                    if(p<sum){\\n                        sum=p;\\n\\n                        ans.clear();\\n                        ans.push_back(list1[i]);\\n                    }\\n\\n                    else if(p==sum){\\n                        ans.push_back(list1[i]);\\n                    }\\n                }\\n            }\\n        }\\n\\n        return ans;\\n    }\\n};\\n\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"minimum-index-sum-of-two-lists","has_notes":false,"flag_type":1,"frontend_id":506},{"id":2075527704,"question_id":599,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1784621382,"status":10,"status_display":"Accepted","runtime":"79 ms","url":"/submissions/detail/2075527704/","is_pending":"Not Pending","title":"Minimum Index Sum of Two Lists","memory":"34.6 MB","code":"class Solution {\\npublic:\\n    vector<string> findRestaurant(vector<string>& list1, vector<string>& list2) {\\n        vector<string>ans;\\n int sum=INT_MAX;\\n        for(int i=0;i<list1.size();i++){\\n           \\n            for(int j=0;j<list2.size();j++){\\n                if(list1[i]==list2[j]){\\n\\n                    int p=i+j;\\n                    if(p<sum){\\n                        sum=p;\\n                        ans.clear();\\n                        ans.push_back(list1[i]);\\n                    }\\n                    else if (p==sum){\\n                        ans.push_back(list1[i]);\\n                    }\\n                }\\n            }\\n        }\\n\\n        return ans;\\n    }\\n};\\n","compare_result":"111111111111111111111111111111111111111111111111