=ch;\\n            }\\n        }\\n mp[word]++;\\n         word=\\"\\";\\n\\n\\n         for(char ch:s2){\\n            if(ch== \' \'){\\n                mp[word]++;\\n                word=\\"\\";\\n            }\\n            else{\\n                word+=ch;\\n            }\\n        }\\n\\n         mp[word]++;\\n         word=\\"\\";\\n\\n        vector<string>ans;\\n\\n        for(auto &p:mp){\\n            if(p.second==1){\\n                ans.push_back(p.first);\\n            }\\n        }\\n        return ans;\\n    }\\n};\\n","compare_result":"1111111111111111111111111111111111111111111111111111111","title_slug":"uncommon-words-from-two-sentences","has_notes":null,"flag_type":1,"frontend_id":702}],"has_next":true,"last_key":""}'
