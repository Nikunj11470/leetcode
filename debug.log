ush_back(temp->val);\\n            temp=temp->next;\\n        }\\n\\n        vector<int>p;\\n        for(int i=0;i<a;i++){\\n            p.push_back(ans[i]);\\n        }\\n\\n        vector<int>q;\\n\\n        ListNode*temp1=list2;\\n\\n        while(temp1!=NULL){\\n            q.push_back(temp1->val);\\n            temp1=temp1->next;\\n        }\\n\\n\\n\\n\\n        for(int i=0;i<q.size();i++){\\n            p.push_back(q[i]);\\n        }\\n\\n\\n        for(int i=b+1;i<ans.size();i++){\\n            p.push_back(ans[i]);\\n        }\\n\\n\\n        ListNode*newNode=new ListNode(p[0]);\\n        temp=newNode;\\n\\n        for(int i=1;i<p.size();i++){\\n            temp->next=new ListNode(p[i]);\\n            temp=temp->next;\\n        }\\n\\n        return newNode;\\n    }\\n};\\n\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111","title_slug":"merge-in-between-linked-lists","has_notes":false,"flag_type":1,"frontend_id":636},{"id":2113836577,"question_id":4213,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1787223517,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2113836577/","is_pending":"Not Pending","title":"Merge Adjacent Equal Elements","memory":"N/A","code":"class Solution {\\npublic:\\n    vector<long long> mergeAdjacent(vector<int>& nums) {\\n\\n        int i = 0;\\n\\n        while(i < nums.size()-1){\\n\\n            if(nums[i] == nums[i+1]){\\n                nums[i] = nums[i] + nums[i+1];\\n\\n                nums.erase(nums.begin()+i+1);\\n\\n                i = 0;   // start again from beginning\\n            }\\n            else{\\n                i++;\\n            }\\n        }\\n\\n        vector<long long> ans;\\n\\n        for(int i=0;i<nums.size();i++){\\n            ans.push_back(nums[i]);\\n        }\\n\\n        return ans;\\n    }\\n};","compare_result":"","title_slug":"merge-adjacent-equal-elements","has_notes":false,"flag_t