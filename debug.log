= \'0\')\\n                binary[i] = \'1\';\\n            else\\n                binary[i] = \'0\';\\n        }\\n\\n        int p=stoi(binary,nullptr,2);\\n        return p;\\n    }\\n};\\n\\n\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"number-complement","has_notes":null,"flag_type":1,"frontend_id":523},{"id":2078145999,"question_id":165,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1784796534,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2078145999/","is_pending":"Not Pending","title":"Compare Version Numbers","memory":"8.2 MB","code":"class Solution {\\npublic:\\n    int compareVersion(string version1, string version2) {\\n       \\n       int i=0;\\n       int j=0;\\n\\n       while(i<version1.size() || j<version2.size()){\\n        int num1=0;\\n        int num2=0;\\n\\n\\n        while(i<version1.size() && version1[i]!=\'.\'){\\n            num1=num1*10+(version1[i]-\'0\');\\n            i++;\\n        }\\n\\n        while(j<version2.size() && version2[j]!=\'.\'){\\n            num2=num2*10+(version2[j]-\'0\');\\n            j++;\\n        }\\n\\n\\n        if(num1<num2){\\n            return -1;\\n        }\\n\\n        if (num1>num2){\\n            return 1;\\n        }\\n        i++;\\n        j++;\\n       }\\n       return 0;\\n    }\\n};\\n\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"compare-version-numbers","has_notes":false,"flag_type":1,"frontend_id":522}],"has_next":true,"last_key":""}'
