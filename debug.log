n\\n        unordered_map<string, int> st;\\n\\n        // Store frequency\\n        for(string temp : words) {\\n            st[temp]++;\\n        }\\n\\n        // Convert map to vector\\n        vector<pair<string, int>> v(st.begin(), st.end());\\n\\n        // Sort\\n        sort(v.begin(), v.end(), [](auto &a, auto &b) {\\n\\n            // Higher frequency first\\n            if(a.second != b.second)\\n                return a.second > b.second;\\n\\n            // Same frequency -> alphabetical order\\n            return a.first < b.first;\\n        });\\n\\n        vector<string> ans;\\n\\n        for(int i = 0; i < k; i++) {\\n            ans.push_back(v[i].first);\\n        }\\n\\n        return ans;\\n    }\\n};","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"top-k-frequent-words","has_notes":null,"flag_type":1,"frontend_id":612},{"id":2105773866,"question_id":462,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 3\xc2\xa0weeks","timestamp":1786642652,"status":15,"status_display":"Runtime Error","runtime":"N/A","url":"/submissions/detail/2105773866/","is_pending":"Not Pending","title":"Minimum Moves to Equal Array Elements II","memory":"N/A","code":"class Solution {\\npublic:\\n    int minMoves2(vector<int>& nums) {\\n\\n        int ans = INT_MAX;\\n\\n        for(int i = 0; i < nums.size(); i++) {\\n\\n            int count = 0;\\n\\n            for(int j = 0; j < nums.size(); j++) {\\n                count += abs(nums[i] - nums[j]);\\n            }\\n\\n            ans = min(ans, count);\\n        }\\n\\n        return ans;\\n    }\\n};","compare_result":"111111111111111111000000000000000","title_slug":"minimum-moves-to-equal-array-elements-ii","has_notes":false,"flag_type":1,"frontend_id":611},{"id":2105771182,"question_id":462,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 3\xc2\xa0weeks","timestamp":1786642542,"status":15,"status_display":"R