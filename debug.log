()){\\n            st.pop();\\n        }\\n        \\n        }\\n       else{\\n        st.push(s[i]);\\n       }\\n        }\\n      \\n        \\n\\n        while(!st.empty()){\\n            char ch=st.top();\\n            st.pop();\\n            st1.push_back(ch);\\n        }\\n\\n        reverse(st1.begin(),st1.end());\\n \\nstring st2;\\n\\n\\n        for(int i=0;i<t.size();i++){\\n\\n        if(t[i]==\'#\'){ \\n        if(!st.empty()){\\n            st.pop();\\n        \\n        }\\n        }\\n        else{\\n          st.push(t[i]);\\n       \\n        }\\n        }\\n      \\n        while(!st.empty()){\\n            char ch=st.top();\\n            st.pop();\\n            st2.push_back(ch);\\n        }\\n\\n        reverse(st2.begin(),st2.end());\\n        if(st1==st2){\\n            return true;\\n        }\\n\\n        return false;\\n    }\\n};\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"backspace-string-compare","has_notes":false,"flag_type":1,"frontend_id":662}],"has_next":true,"last_key":""}'
