ked-list","has_notes":false,"flag_type":1,"frontend_id":651},{"id":2118516273,"question_id":114,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787580697,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2118516273/","is_pending":"Not Pending","title":"Flatten Binary Tree to Linked List","memory":"18 MB","code":"/**\\n * Definition for a binary tree node.\\n * struct TreeNode {\\n *     int val;\\n *     TreeNode *left;\\n *     TreeNode *right;\\n *     TreeNode() : val(0), left(nullptr), right(nullptr) {}\\n *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}\\n *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}\\n * };\\n */\\nclass Solution {\\npublic:\\n\\nvoid preorder(TreeNode*root,vector<TreeNode*>&v){\\n    if(root==NULL){\\n        return;\\n    }\\n    v.push_back(root);\\n    preorder(root->left,v);\\n    preorder(root->right,v);\\n}\\n    void flatten(TreeNode* root) {\\n\\n        if(root==NULL){\\n            return;\\n        }\\n\\n        vector<TreeNode*>v;\\n        preorder(root,v);\\n\\n        for(int i=0;i<v.size()-1;i++){\\n            v[i]->left=NULL;\\n            v[i]->right=v[i+1];\\n        }\\n\\n        v[v.size()-1]->left=NULL;\\n        v[v.size()-1]->right=NULL;\\n\\n    }\\n};\\n\\n\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"flatten-binary-tree-to-linked-list","has_notes":false,"flag_type":1,"frontend_id":650},{"id":2118347185,"question_id":91,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787569910,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2118347185/","is_pending":"Not Pending","title":"Decode Ways","memory":"8.7 MB","code":"class Solution {\\npublic:\\n\\n    int solve(string &s, int i, vector<int> &dp) {\\n\\n        int n = s.length();\\n\\n        if (i == n) {\\n            return 1;\\n        }\\n\\n        if (s[i] == \'0\') {\\n            return 0;\\n        }\\n\\n        // Already calculated\\n        if (dp[i] != -1) {\\n            return dp[i];\\n        }\\n\\n        // Take one digit\\n        int ways = solve(s, i + 1, dp);\\n\\n        // Take two digits\\n        if (i + 1 < n) {\\n\\n            int num = (s[i] - \'0\') * 10\\n                    + (s[i + 1] - \'0\');\\n\\n            if (num >= 10 && num <= 26) {\\n                ways += solve(s, i + 2, dp);\\n            }\\n        }\\n\\n        dp[i] = ways;\\n\\n        return ways;\\n    }\\n\\n    int numDecodings(string s) {\\n\\n        int n = s.length();\\n\\n        vector<int> dp(n, -1);\\n\\n        return solve(s, 0, dp);\\n    }\\n};","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"decode-ways","has_notes":null,"flag_type":1,"frontend_id":649},{"id":2118346280,"question_id":91,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787569846,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2118346280/","is_pending":"Not Pending","title":"Decode Ways","memory":"N/A","code":"class Solution {\\npublic:\\n\\n    int solve(string &s, int i) {\\n        int n = s.length();\\n\\n        // Reached the end\\n        if (i == n) {\\n            return 1;\\n        }\\n\\n        // Current digit is 0\\n        if (s[i] == \'0\') {\\n            return 0;\\n        }\\n\\n        // Take one digit\\n        int ways = solve(s, i + 1);\\n\\n        // Take two digits\\n       