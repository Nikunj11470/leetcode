anned) {\\n       unordered_map<string,int>mp;\\n       unordered_set<string>ban(banned.begin(),banned.end());\\n\\n\\n       for(char &ch:paragraph){\\n        if(isalpha(ch)){\\n            ch=tolower(ch);\\n        }\\n        else{\\n            ch=\' \';\\n        }\\n\\n       }\\n\\n    stringstream ss(paragraph);\\n    string word;\\n\\n    while(ss>>word){\\n      \\n        if(ban.find(word)==ban.end()){\\n            mp[word]++;\\n        \\n\\n       }\\n    }\\n       string ans;\\n       int maxi=0;\\n       for(auto p:mp){\\n\\n        if(p.second>maxi){\\n            maxi=p.second;\\n            ans=p.first;\\n        }\\n       }\\n\\n       return ans;\\n    }\\n};\\n\\n","compare_result":"11111111111111111111111111111111111111111111111111","title_slug":"most-common-word","has_notes":false,"flag_type":1,"frontend_id":643},{"id":2114897289,"question_id":841,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1787305187,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2114897289/","is_pending":"Not Pending","title":"Shortest Distance to a Character","memory":"9.5 MB","code":"class Solution {\\npublic:\\n    vector<int> shortestToChar(string s, char c) {\\n\\n        vector<int>ans(s.size());\\n       for(int i=0;i<s.size();i++){\\n       int left=INT_MAX;\\n       int right=INT_MAX;\\n\\n        for(int j=i;j<s.size();j++){\\n            \\n            if(s[j]==c ){\\n                right=j-i;\\n                break;\\n            }\\n        }\\n\\n        for(int k=i;k>=0;k--){\\n            if(s[k]==c){\\n                left=i-k;\\n                break;\\n            }\\n        }\\n\\n        ans[i]=min(left,right);\\n       }\\n\\n       return ans;\\n    }\\n};\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"shortest-distance-to-a-character","has_notes":false,"flag_type":1,"frontend_id":642}],"has_next":true,"l