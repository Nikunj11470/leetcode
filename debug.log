s Solution {\\npublic:\\n    vector<vector<int>> levelOrder(TreeNode* root) {\\n       vector<vector<int>>level;\\n\\n       if(root==NULL){\\n        return level;\\n       }\\n\\n       queue<TreeNode*>q;\\n\\n\\n       q.push(root);\\n\\n       while(!q.empty()){\\n        int n=q.size();\\n         vector<int>ans;\\n        for(int i=0;i<n;i++){\\n           \\n            TreeNode*temp=q.front();\\n            q.pop();\\n\\n            ans.push_back(temp->val);\\n\\n            if(temp->left){\\n                q.push(temp->left);\\n            }\\n\\n            if(temp->right){\\n                q.push(temp->right);\\n            }\\n\\n        }\\n\\n        level.push_back(ans);\\n       }\\n\\n\\n       return level;\\n    }\\n};\\n","compare_result":"11111111111111111111111111111111111","title_slug":"binary-tree-level-order-traversal","has_notes":false,"flag_type":1,"frontend_id":723},{"id":2161991867,"question_id":222,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0days, 9\xc2\xa0hours","timestamp":1791109804,"status":50,"status_display":"Restrictions Failed","runtime":"N/A","url":"/submissions/detail/2161991867/","is_pending":"Not Pending","title":"Count Complete Tree Nodes","memory":"N/A","code":"class Solution {\\npublic:\\n    int countNodes(TreeNode* root) {\\n\\n        if(root==NULL){\\n            return 0;\\n        }\\n\\n        return 1+countNodes(root->left)+countNodes(root->right);\\n    }\\n};\\n","compare_result":"111111111111111111","title_slug":"count-complete-tree-nodes","has_notes":false,"flag_type":1,"frontend_id":722}],"has_next":true,"last_key":""}'
