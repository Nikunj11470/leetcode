ring s, int k) {\\n        for(int i=0;i<s.size();i++){\\n            for(int j=i+1;j<s.size();j++){\\n                if(s[i]==s[j]){\\n                    if((j-i)<=k){\\n                    s.erase(j,1);\\n                    }\\n                }\\n            }\\n        }\\n\\n        return s;\\n    }\\n};\\n","compare_result":"","title_slug":"merge-close-characters","has_notes":false,"flag_type":1,"frontend_id":624},{"id":2113673824,"question_id":2447,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1787213889,"status":10,"status_display":"Accepted","runtime":"26 ms","url":"/submissions/detail/2113673824/","is_pending":"Not Pending","title":"Merge Similar Items","memory":"20 MB","code":"class Solution {\\npublic:\\n    vector<vector<int>> mergeSimilarItems(vector<vector<int>>& items1, vector<vector<int>>& items2) {\\n       vector<vector<int>>ans;\\n\\n\\n       for(int i=0;i<items1.size();i++){\\n        int p=items1[i][0];\\n        int sum=items1[i][1];\\n        \\n      \\n\\n        for(int j=0;j<items2.size();j++){\\n            if(items2[j][0]==p){\\n                sum+=items2[j][1];\\n               \\n            }\\n        }\\n\\n        \\n\\n        ans.push_back({p,sum});\\n\\n        \\n       }\\n\\n\\n\\n\\n       for(int i=0;i<items2.size();i++){\\n        int p=items2[i][0];\\n        bool q=false;\\n\\n        for(int j=0;j<items1.size();j++){\\n            if(items1[j][0]==p){\\n                q=true;\\n                break;\\n            }\\n        }\\n\\n        if(!q){\\n            ans.push_back({p,items2[i][1]});\\n        }\\n       }\\n\\n\\n       sort(ans.begin(),ans.end());\\n\\n\\n\\n       return ans;\\n    }\\n};\\n\\n","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"merge-similar-items","has_notes":false,"flag_type":1,"frontend_id":623},{"id":2113662196,"question_id":2447,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1787213081,"status":10,"status_display":"Accepted","runtime":"14 ms","url":"/submissions/detail/2113662196/","is_pending":"Not Pending","title":"Merge Similar Items","memory":"19.9 MB","code":"class Solution {\\npublic:\\n    vector<vector<int>> mergeSimilarItems(vector<vector<int>>& items1, vector<vector<int>>& items2) {\\n        \\n        vector<vector<int>> ans;\\n\\n        for(int i=0; i<items1.size(); i++){\\n            int p = items1[i][0];\\n            int sum = items1[i][1];\\n            bool q = false;\\n\\n            for(int j=0; j<items2.size(); j++){\\n                if(items2[j][0] == p){\\n                    sum += items2[j][1];\\n                    q = true;\\n                }\\n            }\\n\\n            ans.push_back({p,sum});\\n        }\\n\\n        // items which are only in items2\\n        for(int i=0; i<items2.size(); i++){\\n            bool q = false;\\n\\n            for(int j=0; j<items1.size(); j++){\\n                if(items2[i][0] == items1[j][0]){\\n                    q = true;\\n                    break;\\n                }\\n            }\\n\\n            if(!q){\\n                ans.push_back({items2[i][0],items2[i][1]});\\n            }\\n        }\\n\\n        sort(ans.begin(),ans.end());\\n\\n        return ans;\\n    }\\n};","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"merge-similar-items","has_notes":false,"flag_type":1,"frontend_id":622}],"has_next":true,"last_key":""}'
