     ListNode(int x) : val(x), next(nullptr) {}\\n *     ListNode(int x, ListNode *next) : val(x), next(next) {}\\n * };\\n */\\nclass Solution {\\npublic:\\n    bool isPalindrome(ListNode* head) {\\n        vector<int>arr;\\n\\n        while(head){\\n            arr.push_back(head->val);\\n            head=head->next;\\n        }\\n\\n        int i=0;\\n        int j=arr.size()-1;\\n\\n        while(i<j){\\n            if(arr[i]!=arr[j]){\\n                return false;\\n            }\\n\\n            i++;\\n            j--;\\n        }\\n\\n        return true;\\n    }\\n};","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"palindrome-linked-list","has_notes":null,"flag_type":1,"frontend_id":397},{"id":2067248439,"question_id":4107,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1784025596,"status":10,"status_display":"Accepted","runtime":"7 ms","url":"/submissions/detail/2067248439/","is_pending":"Not Pending","title":"Find Missing Elements","memory":"32.7 MB","code":"class Solution {\\npublic:\\n    vector<int> findMissingElements(vector<int>& nums) {\\n        int mini=INT_MAX;\\n        int maxi=-1;\\n\\n\\n       for(int i=0;i<nums.size();i++){\\n        mini=min(mini,nums[i]);\\n        maxi=max(maxi,nums[i]);\\n        \\n       }\\n       vector<int>ans;\\n\\n\\n       for(int i=mini;i<=maxi;i++){\\n        ans.push_back(i);\\n       }\\n\\n\\n       vector<int>s;\\n\\n       for(int i=0;i<ans.size();i++){\\n        bool found=false;\\n        for(int j=0;j<nums.size();j++){\\n            if(ans[i]==nums[j]){\\n                found=true;\\n                break;\\n            }\\n        }\\n        if(!found){\\n            s.push_back(ans[i]);\\n        }\\n       }\\n       return s;\\n    }\\n};\\n","compare_result":"","title_slug":"find-missing-elements","has_notes":false,"flag_type":1,"frontend_id":396},{"id":2067226841,"question_id":381