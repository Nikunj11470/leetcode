331},{"id":2061421852,"question_id":2212,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1783582198,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2061421852/","is_pending":"Not Pending","title":"Removing Minimum and Maximum From Array","memory":"92.1 MB","code":"class Solution {\\npublic:\\n    int minimumDeletions(vector<int>& nums) {\\n        int mini = INT_MAX;\\n        int maxi = INT_MIN;\\n\\n        for(int i = 0; i < nums.size(); i++){\\n            maxi = max(maxi, nums[i]);\\n            mini = min(mini, nums[i]);\\n        }\\n\\n        int p = 0;\\n        for(int i = 0; i < nums.size(); i++){\\n            if(nums[i] == maxi){\\n                p = i + 1;\\n                break;\\n            }\\n        }\\n\\n        int q = 0;\\n        for(int i = 0; i < nums.size(); i++){\\n            if(nums[i] == mini){\\n                q = i + 1;\\n                break;\\n            }\\n        }\\n\\n        int r = 0;\\n        for(int i = nums.size()-1; i >= 0; i--){\\n            if(nums[i] == maxi){\\n                r = nums.size() - i;\\n                break;\\n            }\\n        }\\n\\n        int s = 0;\\n        for(int i = nums.size()-1; i >= 0; i--){\\n            if(nums[i] == mini){\\n                s = nums.size() - i;\\n                break;\\n            }\\n        }\\n\\n        int op1 = max(p, q);\\n        int op2 = max(r, s);\\n        int op3 = min(p + s, q + r);\\n\\n        return min({op1, op2, op3});\\n    }\\n};","compare_result":"11111111111111111111111111111111111111111111111111111111111111","title_slug":"removing-minimum-and-maximum-from-array","has_notes":false,"flag_type":1,"frontend_id":330},{"id":2061420513,"question_id":2212,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1783582111,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2061420513/","is_pending":"Not Pending","title":"Removing Minimum and Maximum From Array","memory":"N/A","code":"class Solution {\\npublic:\\n    int minimumDeletions(vector<int>& nums) {\\n        int mini=INT_MAX;\\n        int maxi=-1;\\n        for(int i=0;i<nums.size();i++){\\n            if(nums[i]>maxi){\\n                maxi=nums[i];\\n            }\\n        }\\n\\n        for(int i=0;i<nums.size();i++){\\n            if(nums[i]<mini){\\n                mini=nums[i];\\n            }\\n        }\\n\\n         int p=0;\\n        for(int i=0;i<nums.size();i++){\\n            if(nums[i]==maxi){\\n                   p=i+1;\\n                break;\\n            }\\n        }\\n\\n        int q=0;\\n        for(int i=0;i<nums.size();i++){\\n            if(nums[i]==mini){\\n                q=i+1;\\n                break;\\n            }\\n        }\\n\\n        int r=0;\\n\\n        for(int i=nums.size()-1;i>=0;i--){\\n            if(nums[i]==maxi){\\n                r=nums.size()-1-i+1;\\n                break;\\n            }\\n        }\\n\\n        int s=0;\\n\\n        for(int i=nums.size()-1;i>=0;i--){\\n            if(nums[i]==mini){\\n                s=nums.size()-1-i+1;\\n                break;\\n            }\\n        }\\n\\n\\n        int op1=max(p,q);\\n        int op2=max(r,s);\\n        int op3=min(p+s,q+r);\\n\\n        return min({op1,op2,op3});\\n\\n    }\\n};\\n\\n\\n\\n\\n            ","compare_result":"11111111111111111111111111111111111111111111111111111110111111","title_slug":"removing-minimum-and-maximum-from-array","has_notes":false,"flag_type":1,"frontend_id":329},{"id":2061396023,"question_id":3337,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1783580708,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2061396023/","is_pending":"Not Pending","title":"Count Substrings Starting and Ending with Given Character","memory":"13.2 MB","code":"class Solution {\\npublic:\\n    long long countSubstrings(string