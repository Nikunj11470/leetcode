g order, string s) {\\n        unordered_map<char,int>mp;\\n        string ans=\\"\\";\\n\\n        for(char c:s){\\n            mp[c]++;\\n        }\\n\\n        for(char c:order){\\n            while(mp[c]>0){\\n                ans.push_back(c);\\n                mp[c]--;\\n            }\\n        }\\n\\n        for(auto &p:mp){\\n            while(p.second){\\n                ans.push_back(p.first);\\n                p.second--;\\n            }\\n        }\\n        return ans;\\n    }\\n};\\n","compare_result":"11111111111111111111111111111111111111111","title_slug":"custom-sort-string","has_notes":false,"flag_type":1,"frontend_id":223},{"id":2045451397,"question_id":167,"lang":"cpp","lang_name":"C++","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782371013,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2045451397/","is_pending":"Not Pending","title":"Two Sum II - Input Array Is Sorted","memory":"19.4 MB","code":"class Solution {\\npublic:\\n    vector<int> twoSum(vector<int>& numbers, int target) {\\n        int s=0;\\n        int e=numbers.size()-1;\\n\\n        while(s<e){\\n\\n            int sum=numbers[s]+numbers[e];\\n\\n            if(sum<target){\\n                s++;\\n            }\\n            if(sum>target){\\n                e--;\\n            }\\n            if(sum==target){\\n                return {s+1,e+1};\\n            }\\n        }\\n        return {};\\n    }\\n};\\n\\n","compare_result":"111111111111111111111111","title_slug":"two-sum-ii-input-array-is-sorted","has_notes":null,"flag_type":1,"frontend_id":222}],"has_next":true,"last_key":""}'
