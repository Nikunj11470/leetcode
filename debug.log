ending":"Not Pending","title":"Longest Balanced Subarray I","memory":"530.5 MB","code":"class Solution {\\npublic:\\n    int longestBalanced(vector<int>& nums) {\\n\\n        int n = nums.size();\\n        int ans = 0;\\n\\n        for(int i = 0; i < n; i++) {\\n\\n            unordered_set<int> even;\\n            unordered_set<int> odd;\\n\\n            for(int j = i; j < n; j++) {\\n\\n                if(nums[j] % 2 == 0)\\n                    even.insert(nums[j]);\\n                else\\n                    odd.insert(nums[j]);\\n\\n                if(even.size() == odd.size())\\n                    ans = max(ans, j - i + 1);\\n            }\\n        }\\n\\n        return ans;\\n    }\\n};","compare_result":"","title_slug":"longest-balanced-subarray-i","has_notes":null,"flag_type":1,"frontend_id":408},{"id":2068369123,"question_id":1055,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1784105489,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2068369123/","is_pending":"Not Pending","title":"Pairs of Songs With Total Durations Divisible by 60","memory":"N/A","code":"class Solution {\\npublic:\\n    int numPairsDivisibleBy60(vector<int>& time) {\\n        int count=0;\\n       for(int i=0;i<time.size();i++){\\n        for(int j=i+1;j<time.size();j++){\\n            if((time[i]+time[j])%60==0){\\n                count++;\\n            }\\n        }\\n       }\\n       return count;\\n    }\\n};\\n","compare_result":"11111111111111111111111111111111100","title_slug":"pairs-of-songs-with-total-durations-divisible-by-60","has_notes":false,"flag_type":1,"frontend_id":407},{"id":2068341891,"question_id":493,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1784103889,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2068341891/","is_pending":"Not Pending","title":"Reverse Pairs","memory":"N/A","code":"class Solu